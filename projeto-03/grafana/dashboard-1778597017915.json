      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Variação Percentual 24h por Wallet",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "aflrrrsb4hn9cf"
                      },
                      "spec": {
                        "dataset": "bsc_coletas",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  LEFT(wallet, 6) || '...' || RIGHT(wallet, 4) AS wallet,\r\n  ROUND(\r\n    ((saldo_atual - saldo_anterior) / NULLIF(saldo_anterior, 0) * 100)::numeric,\r\n    2\r\n  ) AS variacao_percentual\r\nFROM (\r\n  SELECT\r\n    wallet,\r\n    FIRST_VALUE(saldo) OVER (PARTITION BY wallet ORDER BY coletado_em DESC) AS saldo_atual,\r\n    FIRST_VALUE(saldo) OVER (PARTITION BY wallet ORDER BY coletado_em ASC)  AS saldo_anterior,\r\n    ROW_NUMBER() OVER (PARTITION BY wallet ORDER BY coletado_em DESC) AS rn\r\n  FROM consultas\r\n  WHERE coletado_em >= NOW() - INTERVAL '24 hours'\r\n) sub\r\nWHERE rn = 1",
                        "sql": {
                          "columns": [
